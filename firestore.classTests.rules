// =====================================================================
//  Class Tests — Firestore security rules block
// ---------------------------------------------------------------------
//  This is NOT a complete rules file and is never deployed from the repo.
//  Paste everything between the START and END lines into your existing
//  rules in the Firebase console (Firestore → Rules), INSIDE this block:
//
//      match /databases/{database}/documents {
//        ... your existing rules stay as they are ...
//        <paste here>
//      }
//
//  It adds new functions whose names all start with "ct" so they cannot
//  clash with your existing helper functions. It only grants access to
//  classTests/**, so it does not change access to students, marks,
//  attendance or users.
// =====================================================================

// ----- START: Class Tests -----

    // Caller's users/{uid} profile (one document read, re-used by the helpers below).
    function ctUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function ctIsStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ctUser().role in ['admin', 'teacher'];
    }
    function ctIsAdmin() {
      return ctIsStaff() && ctUser().role == 'admin';
    }
    // Same aliases as SUBJECT_ALIASES in admin.html / teacher.html.
    function ctCanonSubject(s) {
      return {'Science/E.V.S.': 'Science', 'S.S.T.': 'SST', 'G.K.': 'GK'}.get(s, s);
    }
    // Teacher may work on test t when its class is assigned to them and the subject is theirs.
    function ctTeacherOwns(t) {
      return ctIsStaff()
        && ctUser().role == 'teacher'
        && t.class in ctUser().get('assignedClasses', [])
        && (ctUser().get('subject', '') == 'All Subjects'
            || ctCanonSubject(ctUser().get('subject', '')) == t.subject);
    }

    match /classTests/{testId} {
      function ctTest() {
        return get(/databases/$(database)/documents/classTests/$(testId)).data;
      }
      // Teachers write marks only while the parent test is a draft.
      function ctCanWriteMarks() {
        return ctIsAdmin() || (ctTeacherOwns(ctTest()) && ctTest().status == 'draft');
      }

      allow read: if ctIsStaff();

      allow create: if ctIsAdmin()
        || (ctTeacherOwns(request.resource.data)
            && request.resource.data.status == 'draft'
            && request.resource.data.createdBy == request.auth.uid);

      // Teachers: full edits while draft (draft → final allowed).
      // After finalising, teachers may only refresh the list summary and report notes;
      // only admin can change marks setup or set status back to draft.
      allow update: if ctIsAdmin()
        || (ctTeacherOwns(resource.data)
            && ctTeacherOwns(request.resource.data)
            && (resource.data.status == 'draft'
                || (request.resource.data.status == 'final'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['summary', 'updatedAt', 'recommendedAction', 'questionNotes']))));

      // Finalised tests can be deleted only by admin.
      allow delete: if ctIsAdmin()
        || (ctTeacherOwns(resource.data) && resource.data.status == 'draft');

      match /results/{studentId} {
        allow read: if ctIsStaff();
        allow create, update: if ctCanWriteMarks()
          && request.resource.data.enteredBy == request.auth.uid;
        allow delete: if ctCanWriteMarks();

        // Change log: append-only for staff. Only admin may delete (when removing a whole test).
        match /history/{historyId} {
          allow read: if ctIsStaff();
          allow create: if ctCanWriteMarks()
            && request.resource.data.changedBy == request.auth.uid;
          allow update: if false;
          allow delete: if ctIsAdmin();
        }
      }
    }

    // Collection-group reads of results (used later by the CBSE knowledge view).
    match /{path=**}/results/{studentId} {
      allow read: if ctIsStaff();
    }

// ----- END: Class Tests -----
